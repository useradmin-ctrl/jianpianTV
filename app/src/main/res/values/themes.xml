<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Leanback 主主题 -->
    <style name="Theme.Leanback" parent="@style/Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">#FF6B35</item>
        <item name="android:colorAccent">#FF6B35</item>
    </style>

    <!-- 播放器全屏主题 -->
    <style name="Theme.Leanback.Playback" parent="@style/Theme.Leanback">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
